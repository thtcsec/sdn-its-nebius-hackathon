# Copy to repository-root .env (gitignored) — never commit real keys.
# Loaded via sdn_its.utils.env (python-dotenv). Process env vars win over this file.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Prefer a currently listed NVIDIA open model on Token Factory, e.g.:
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Alternatives (confirm via scripts/verify_nebius_nemotron.py list_models):
# NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# —— Hosted / judge demo (server-side only) ——
# Explicit hosted mode: refuse to start without a strong SDN_API_TOKEN; force mock OF;
# disable legacy /run and /investigate (product path = /multistep only).
# SDN_HOSTED_DEMO=1
# SDN_API_TOKEN=  # required when SDN_HOSTED_DEMO=1; ≥16 chars, not a placeholder
# SDN_OF_BACKEND=mock
# Application daily spend quota (USD) — NOT a Nebius provider hard cap.
NEBIUS_DAILY_BUDGET_USD=1.0
JT_RESERVE_USD_PER_REAL=0.05
JT_RATE_LIMIT_PER_MIN=8
JT_MAX_CONCURRENT_REAL=2
JT_MAX_MODEL_CALLS=5
# JT_QUOTA_DB_PATH=artifacts/hackathon/quota/nebius_daily_quota.sqlite
# Only honor X-Forwarded-For when the process sits behind a trusted reverse proxy:
# JT_TRUSTED_PROXY=0
# Bind (default loopback). Hosted: SDN_BIND_HOST=0.0.0.0 + SDN_HOSTED_DEMO=1 + token.
# SDN_BIND_HOST=127.0.0.1
