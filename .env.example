# Copy to repository-root .env (gitignored) — never commit real keys.
# Loaded via sdn_its.utils.env (python-dotenv). Process env vars win over this file.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Prefer a currently listed NVIDIA open model on Token Factory, e.g.:
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Alternatives (confirm via scripts/verify_nebius_nemotron.py list_models):
# NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# —— Hosted / judge demo (server-side only) ——
# Shared judge token: required for POST /api/v1/hackathon/multistep and GET .../audit when set.
# Local loopback demo may omit this; hosted deployments SHOULD set it.
# SDN_API_TOKEN=
# Force server demo policy even without token (demo_mode=true, no containment):
# SDN_HOSTED_DEMO=1
# Daily Nebius spend cap (USD). Real-mode calls rejected with 429 when exhausted.
NEBIUS_DAILY_BUDGET_USD=1.0
# Per-client real-mode request rate (per rolling minute) and concurrency:
JT_RATE_LIMIT_PER_MIN=8
JT_MAX_CONCURRENT_REAL=2
# Bind (default loopback). Hosted: SDN_BIND_HOST=0.0.0.0 and always set SDN_API_TOKEN.
# SDN_BIND_HOST=127.0.0.1
