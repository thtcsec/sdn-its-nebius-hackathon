# Copy to deploy/judge/.env (gitignored) — never commit real values.
# Required for SDN_HOSTED_DEMO=1 fail-closed startup.

# REJECTED by token_is_secure() if left unchanged — generate a real random token.
SDN_API_TOKEN=replace-with-32plus-char-random-token
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Public hostname for Caddy HTTPS (Let's Encrypt). Example: jt-demo.example.com
JT_DOMAIN=localhost

# Application quota (not a Nebius provider hard cap)
NEBIUS_DAILY_BUDGET_USD=1.0
JT_RESERVE_USD_PER_REAL=0.05
JT_RATE_LIMIT_PER_MIN=8
JT_MAX_CONCURRENT_REAL=2
JT_MAX_MODEL_CALLS=5
JT_REAL_TIMEOUT_S=90
