# TLS terminator for JunctionTrace judge demo.
# Set JT_DOMAIN in .env (e.g. jt-demo.example.com). For local smoke use :8080 without Caddy.

{$JT_DOMAIN} {
	encode gzip
	# Strip any Authorization echo from upstream error pages is app responsibility.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy app:8080 {
		# Preserve client IP for rate limits (app has JT_TRUSTED_PROXY=1)
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}
}
